<div class ="container">
  <div id="title-pane">
    <h1>Trends</h1>
    <div class="description">
      <% @gems_data.each_with_index do |gem, index| %>
        <strong><%= gem[:name] %></strong><%= index < @gems_data.length - 1 ? ' vs ' : '' %>
      <% end %>
    </div>
  </div>
</div>

<div class="container">
  <form class="trends-form" action="/trends" method="get">
    <input type="hidden" name="current_gems" value="<%= @gems_data.map { |g| g[:name] }.join(', ') %>">
    <input type="text" name="gems" placeholder="Add gem to comparison" value="">
    <button type="submit">Add Gem</button>
  </form>

  <div class="gems-list">
    <% @gems_data.each do |gem| %>
      <span class="gem-tag" style="border: 2px solid <%= gem[:color] %>;">
        <%= gem[:name] %>
        <a href="<%= remove_gem_url(@gems_data, gem) %>" class="remove-gem">×</a>
      </span>
    <% end %>
  </div>
</div>

<div class="container">
  <table>
    <thead>
      <th class="gem-color-header"></th>
      <th></th>
      <th></th>
      <th>Total Downloads</th>
      <th>Total Rank</th>
      <th>Daily Downloads</th>
      <th>Daily Rank</th>
    </thead>
    <tbody>
      <% @gems_data.each do |gem| %>
        <tr>
          <td class="gem-color-cell">
            <div class="gem-color" style="background-color: <%= gem[:color] %>;">
            </div>
          </td>
          <td>
            <a href="/gems/<%= gem[:name] %>" target="_blank"><%= gem[:name] %></a>
          </td>
          <td>
            <div class="gem-links">
              <a class="gem-link" href="https://rubygems.org/gems/<%= gem[:name]%>" target="_blank">
                <svg class="icon icon-rubygems">
                  <use href="#icon-rubygems"></use>
                </svg>
              </a>
              <% if gem[:github_url] %>
                <a class="gem-link" href="<%= gem[:github_url] %>" target="_blank">
                  <svg class="icon icon-github">
                    <use href="#icon-github"></use>
                  </svg>
                </a>
              <% end %>
            </div>
          </td>
          <td><%= comma(gem[:total_downloads]) %></td>
          <td><%= comma(gem[:total_rank]) %></td>
          <td><%= comma(gem[:daily_downloads]) %></td>
          <td><%= comma(gem[:daily_rank]) %></td>
        </tr>
      <% end %>
    </tbody>
  </table>
</div>

<div class="container">
  <div class="trends">
    <h4>Downloads Trends</h4>
    <div>
      <canvas id="total-downloads-trends-chart"></canvas>
    </div>
    <div>
      <canvas id="daily-downloads-trends-chart"></canvas>
    </div>
  </div>

  <div class="trends">
    <h4>Ranking Trends</h4>
    <div>
      <canvas id="total-ranking-trends-chart"></canvas>
    </div>
    <div>
      <canvas id="daily-ranking-trends-chart"></canvas>
    </div>
  </div>

  <div class="trends">
    <h4>Num of Versions Trends</h4>
    <div>
      <canvas id="num-of-versions-trends-chart"></canvas>
    </div>
  </div>
</div>

<script src="https://cdnjs.cloudflare.com/ajax/libs/Chart.js/2.7.1/Chart.bundle.min.js"></script>
<script>
'use strict';

var total_downloads_data = <%= chart_data_json(@merged_downloads[:labels], chart_datasets(@gems_data, @merged_downloads[:total_downloads])) %>;
var daily_downloads_data = <%= chart_data_json(@merged_downloads[:labels], chart_datasets(@gems_data, @merged_downloads[:daily_downloads])) %>;
var total_ranking_data = <%= chart_data_json(@merged_rankings[:labels], chart_datasets(@gems_data, @merged_rankings[:total_ranking])) %>;
var daily_ranking_data = <%= chart_data_json(@merged_rankings[:labels], chart_datasets(@gems_data, @merged_rankings[:daily_ranking])) %>;
var num_of_versions_data = <%= chart_data_json(@merged_num_of_versions[:labels], chart_datasets(@gems_data, @merged_num_of_versions[:num])) %>;

function draw_total_downloads_chart() {
  var ctx = document.getElementById("total-downloads-trends-chart").getContext("2d");
  window.total_downloads_line = Chart.Line(ctx, {
    data: total_downloads_data,
    options: {
      responsive: true,
      hoverMode: 'index',
      stacked: false,
      title:{
        display: true,
        text: 'Total Downloads Trends'
      },
      scales: {
        yAxes: [{
          type: "linear",
          display: true,
          position: "left",
          ticks: {
            reverse: false,
            min: 0
          }
        }]
      },
      animation: {
        duration: 0
      }
    }
  });
};

function draw_daily_downloads_chart() {
  var ctx = document.getElementById("daily-downloads-trends-chart").getContext("2d");
  window.daily_downloads_line = Chart.Line(ctx, {
    data: daily_downloads_data,
    options: {
      responsive: true,
      hoverMode: 'index',
      stacked: false,
      title:{
        display: true,
        text: 'Daily Downloads Trends'
      },
      scales: {
        yAxes: [{
          type: "linear",
          display: true,
          position: "left",
          ticks: {
            reverse: false,
            min: 0
          }
        }]
      },
      animation: {
        duration: 0
      }
    }
  });
};

function draw_total_ranking_chart() {
  var ctx = document.getElementById("total-ranking-trends-chart").getContext("2d");
  window.total_ranking_line = Chart.Line(ctx, {
    data: total_ranking_data,
    options: {
      responsive: true,
      hoverMode: 'index',
      stacked: false,
      title:{
        display: true,
        text: 'Total Ranking Trends'
      },
      scales: {
        yAxes: [{
          type: "linear",
          display: true,
          position: "left",
          ticks: {
            reverse: true,
          }
        }]
      },
      animation: {
        duration: 0
      }
    }
  });
};

function draw_daily_ranking_chart() {
  var ctx = document.getElementById("daily-ranking-trends-chart").getContext("2d");
  window.daily_ranking_line = Chart.Line(ctx, {
    data: daily_ranking_data,
    options: {
      responsive: true,
      hoverMode: 'index',
      stacked: false,
      title:{
        display: true,
        text: 'Daily Ranking Trends'
      },
      scales: {
        yAxes: [{
          type: "linear",
          display: true,
          position: "left",
          ticks: {
            reverse: true,
          }
        }]
      },
      animation: {
        duration: 0
      }
    }
  });
};

function draw_num_of_versions_chart() {
  var ctx = document.getElementById("num-of-versions-trends-chart").getContext("2d");
  window.num_of_versions_line = Chart.Line(ctx, {
    data: num_of_versions_data,
    options: {
      responsive: true,
      hoverMode: 'index',
      stacked: false,
      title:{
        display: true,
        text:'Num of Versions Trends'
      },
      scales: {
        yAxes: [{
          type: "linear",
          display: true,
          position: "left",
          ticks: {
            reverse: false,
            min: 0
          },
        }],
      },
      animation: {
        duration: 0
      }
    }
  });
};

window.onload = function() {
  draw_total_downloads_chart();
  draw_daily_downloads_chart();
  draw_total_ranking_chart();
  draw_daily_ranking_chart();
  draw_num_of_versions_chart();
}

</script>

<%= erb :_banner %>
