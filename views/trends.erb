<div class ="container">
  <div id="title-pane">
    <h1>Trends</h1>
    <div class="description">Compare gems download counts over time</div>
  </div>
</div>

<div class="container">
  <form class="trends-form" action="/trends" method="get">
    <div class="autocomplete-container">
      <input type="text" name="gems" id="gem-search" placeholder="Enter gem name (e.g., rails, sinatra)" value="">
      <div id="autocomplete-results" class="autocomplete-results"></div>
    </div>
  </form>
</div>

<div class="container">
  <h2>Comparison examples</h2>
  <ul>
    <% @popular_comparisons.each do |comparison| %>
      <li>
        <a href="/trends/<%= comparison[:gems].join('-vs-') %>"><%= comparison[:title] %></a>
      </li>
    <% end %>
  </ul>
</div>

<script src="/assets/js/autocomplete.js"></script>
<script>
'use strict';

window.onload = function() {
  initGemAutocomplete();
}

</script>

<%= erb :_banner %>
